# ══════════════════════════════════════════════════════════════════
# V.E.C.T.O.R — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is in .gitignore.
# ══════════════════════════════════════════════════════════════════

# ── REQUIRED TO START ─────────────────────────────────────────────
# Ollama must be running: `ollama serve`
# Models must be loaded: see modelfiles/ folder
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m

# VECTOR runtime config
VECTOR_ENV=development
VECTOR_DEBUG=true
VECTOR_DB_KEY=              # SQLCipher encryption key. Leave empty to auto-generate via OS keyring.
VECTOR_VAULT_PATH=C:/Users/Arghyadeep/Desktop/V.E.C.T.O.R/V.E.C.T.O.R. Brain
VECTOR_DB_PATH=vector_memory.db
VECTOR_OWNER=Arghyadeep

# ── KIIT PORTAL (attendance scraper) ─────────────────────────────
# Required for kiit_scraper.py to work
KIIT_USERNAME=your_roll_number@kiit.ac.in
KIIT_PASSWORD=your_kiit_password

# ── NOTIFICATIONS (Pushover) ──────────────────────────────────────
# Get from https://pushover.net — free tier works
# Required for RED/YELLOW gateway alerts on your phone
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# ── GITHUB ────────────────────────────────────────────────────────
# Required for GitBot PR creation (git_status/commit works without it)
# Get from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=ArghyadeepDeb

# ── LLM COUNCIL (cloud models — optional, free tiers) ────────────
# Gemini 2.5 Pro — 1500 req/day free
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_key_here

# GLM-5.1 (council chairman fallback) — free via Ollama cloud
# No key needed if using `ollama run glm4:9b` locally
GLM_API_KEY=

# Kimi K2.6 — free via Ollama cloud
# No key needed if using `ollama run kimi-k2.6:cloud` locally
KIMI_API_KEY=

# ── CLOUD DATABASES (optional — local SQLite works without these) ─
# Supabase — free tier at https://supabase.com
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=eyJ_your_anon_key_here

# Turso — free tier at https://turso.tech
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=your_turso_token_here

# ── SECURITY ──────────────────────────────────────────────────────
# VirusTotal — free 4 req/min at https://www.virustotal.com/gui/my-apikey
# Required for malware_hunter 3-layer scan
VIRUSTOTAL_API_KEY=your_vt_key_here

# External task API key — REQUIRED to use POST /api/v1/tasks from phone/cloud/ESP32.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the endpoint (fail-closed). Set VECTOR_ALLOW_OPEN_TASK_API=1
# to allow unauthenticated access in dev (NOT for production).
VECTOR_TASK_API_KEY=
# VECTOR_ALLOW_OPEN_TASK_API=1   # uncomment for local dev only

# ── RESEARCH ──────────────────────────────────────────────────────
# NewsAPI — free 100 req/day at https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# Reddit — free at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=VECTOR/1.0

# ── GOOGLE SERVICES (optional) ────────────────────────────────────
# Required for Google Calendar integration and Bengali/Assamese TTS
# Get from https://console.cloud.google.com
GOOGLE_APPLICATION_CREDENTIALS=google_credentials.json
GOOGLE_CLOUD_PROJECT=your_project_id

# ── CLOUDFLARE (deployment — not needed for local run) ────────────
CF_ACCOUNT_ID=your_cf_account_id
CF_API_TOKEN=your_cf_api_token

# ── ANTHROPIC (build sessions only — NEVER used at runtime) ───────
# RULE 11: Claude API is NEVER called during VECTOR autonomous operation.
# Only used in Claude Code build sessions (your Pro plan handles this).
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── STRIPE (future SaaS — not needed now) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here

# ── LANGSMITH (agent tracing + eval — optional, free tier) ────────
# Get a key from https://smith.langchain.com/settings/apikeys (free
# Developer tier: 5,000 traces/mo, no card required, hard-stops at cap).
# ollama_safe.chat() is wrapped in @traceable, so every LLM call gets
# traced automatically once these are set — leave blank to disable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=VECTOR-eval
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=

# ══════════════════════════════════════════════════════════════════
# QUICK START CHECKLIST:
# 1. Copy this file: cp .env.example .env
# 2. Fill in KIIT_USERNAME + KIIT_PASSWORD
# 3. Fill in PUSHOVER_TOKEN + PUSHOVER_USER (for phone alerts)
# 4. Run: ollama serve
# 5. Run: ollama create vector-focus -f modelfiles/vector-focus.modelfile
# 6. Run: ollama create vector-chairman -f modelfiles/vector-chairman.modelfile
# 7. Run: python run_vector.py smoke   (verify everything works)
# 8. Run: python run_vector.py loop    (start VECTOR)
# ══════════════════════════════════════════════════════════════════
