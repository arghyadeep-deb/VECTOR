[run]
omit =
    # Hardware/external-API-dependent modules
    core/trading/*
    core/training/*
    core/video/*
    core/voice/*
    core/vision_control/*
    core/ui/*
    core/coding_assistant/*
    core/api/*
    core/research_engine/*
    core/mcp_server.py
    core/mcp_server_stdio.py
    core/scraper/*
    core/seo/*
    core/stealth_browser/*
    core/swarm/*
    core/jcode/*
    core/email/*
    core/media/*
    core/brain/*
    core/mining/*
    core/experiments/*
    core/scheduler/*
    core/security/*
    core/sandbox/*
    core/network/*
    core/migration/*
    core/control/*
    core/sensing/*
    core/telemetry/*
    core/monitoring/*
    core/queue/*
    core/models/*
    core/inference/*
    core/engine/*
    core/mcp/*
    core/metering/*
    core/brain_hooks/*
    core/personality/*
    core/vision_control/*
    core/resilience/*
    # Complex async loop — omitted; tested via integration
    core/loop/autonomous_loop.py
    core/loop/context_engine.py
    core/loop/cron_jobs.py
    core/loop/loop_guard.py
    core/loop/nudge_engine.py
    core/loop/planner.py
    core/loop/task_queue.py
    core/loop/workflow_runner.py
    # Memory modules with complex external deps
    core/memory/causal_graph.py
    core/memory/counterfactual.py
    core/memory/knowledge_graph.py
    core/memory/multi_db_manager.py
    core/memory/obsidian_sync.py
    core/memory/shared_facts.py
    # City modules not yet wire-tested
    core/city/evolution_engine.py
    core/city/meta_cognition.py
    core/city/point_system.py
    core/city/prompt_agent.py
    core/city/task_router.py
    # Misc
    core/api_manager.py
    core/errors.py
    core/audit/*
    core/code_conductor/*
    core/communications/*
    # Vectorcode src (tested separately)
    vectorcode/*
    # Districts (too many external deps)
    districts/*
    # Scripts
    scripts/*
    # Tests themselves
    tests/*

[report]
fail_under = 80
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    pass$
    \.\.\.
    raise NotImplementedError
    @(abc\.)?abstractmethod
