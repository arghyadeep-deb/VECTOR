{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VECTOR",
  "version": "1.0.0",
  "identifier": "com.vector.desktop",
  "build": {
    "beforeDevCommand": "cd ../../core/ui/dashboard && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../../core/ui/dashboard && npm run build",
    "frontendDist": "../../core/ui/dashboard/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VECTOR — JARVIS HUD",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "fullscreen": true,
        "transparent": true,
        "alwaysOnTop": false,
        "url": "/",
        "center": true,
        "shadow": false,
        "theme": "Dark",
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: ipc: https://ipc.localhost; img-src 'self' data: blob: https: tauri:; connect-src 'self' http://127.0.0.1:* https://127.0.0.1:* ws://127.0.0.1:* wss://127.0.0.1:* http://localhost:* ws://localhost:* tauri: ipc:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: ipc:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**", "$HOME/.vector/**"]
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "VECTOR — running"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Arghyadeep Deb",
    "copyright": "© 2026 Arghyadeep Deb",
    "category": "Productivity",
    "shortDescription": "VECTOR — local-first personal AI city",
    "longDescription": "VECTOR is a local-first personal AI assistant built around a city metaphor: 27+ specialized district agents (coding, security, finance, health, research, etc.), durable memory, multi-model orchestration via Ollama, and full energy/efficiency telemetry. All inference runs on your hardware by default.",
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {}
}
