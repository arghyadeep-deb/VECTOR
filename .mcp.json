{
  "mcpServers": {
    "vector": {
      "command": "python",
      "args": ["core/mcp_server.py"],
      "cwd": "C:/Users/Arghyadeep/Desktop/V.E.C.T.O.R/V.E.C.T.O.R. Codebase"
    },
    "gitnexus": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "gitnexus@latest", "mcp"],
      "env": {
        "GITNEXUS_REPO_PATH": "C:/Users/Arghyadeep/Desktop/V.E.C.T.O.R/V.E.C.T.O.R. Codebase"
      }
    },
    "vectorcode-intel": {
      "type": "stdio",
      "command": "node",
      "args": ["vectorcode/code_intel/dist/index.js"],
      "cwd": "C:/Users/Arghyadeep/Desktop/V.E.C.T.O.R/V.E.C.T.O.R. Codebase",
      "env": {
        "EMBEDDING_PROVIDER": "ollama",
        "VECTORCODE_OLLAMA_MODE": "external",
        "VECTORCODE_OLLAMA_URL": "http://127.0.0.1:11434",
        "VECTORCODE_QDRANT_MODE": "external",
        "VECTORCODE_QDRANT_URL": "http://127.0.0.1:6333"
      }
    },
    "NotFair-GoogleAds": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://notfair.co/api/mcp/google_ads"]
    },
    "NotFair-MetaAds": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://notfair.co/api/mcp/meta_ads"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless", "--port", "8931"]
    },
    "glif": {
      "command": "node",
      "args": ["core/mcp_servers/glif/index.js"],
      "cwd": "C:/Users/Arghyadeep/Desktop/V.E.C.T.O.R/V.E.C.T.O.R. Codebase",
      "env": {
        "GLIF_API_TOKEN": "${GLIF_API_TOKEN}"
      }
    }
  }
}
