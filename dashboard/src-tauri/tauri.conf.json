{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "VECTOR",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": { "all": true },
      "shell": { "all": false, "execute": false, "open": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "ai.vector.desktop",
      "icon": ["icons/icon.png"],
      "category": "ProductivityApplication"
    },
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "VECTOR",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ]
  }
}
