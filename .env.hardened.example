# VECTOR hardened-mode environment template.
# Copy to your deployment secret manager or a local .env.hardened file.
# Do not commit real secrets.

# Runtime mode. This enables strict readiness (the HUD is always frontend/VECTOR.html).
VECTOR_ENV=vector

# Required production secrets.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VECTOR_API_KEY=
VECTOR_JWT_SECRET=
HUMANLAYER_API_KEY=

# Data root for persistent runtime state. Use an absolute path in production.
VECTOR_DATA_DIR=

# Optional sidecar install paths. Required by /health/hardened-readiness when optional checks are included.
VECTOR_COMFYUI_PATH=
VECTOR_LIBRECHAT_PATH=
VECTOR_UITARS_PATH=

# Common local service URLs. Keep localhost unless deploying these behind authenticated private networking.
OLLAMA_HOST=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188
LIBRECHAT_URL=http://127.0.0.1:3080

# Observability, optional.
SENTRY_DSN=