{
  "name": "@vectorcode/tui",
  "version": "0.1.0",
  "description": "VectorCode terminal UI - React/Ink-based interactive interface",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vector-tui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "eventsource": "^2.0.2",
    "ink": "^5.1.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-syntax-highlight": "^2.0.2",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.2.0",
    "wrap-ansi": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.13",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
